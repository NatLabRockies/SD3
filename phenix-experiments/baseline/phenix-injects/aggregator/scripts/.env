# MongoDB Configuration
MONGO_USERNAME="root"
MONGO_PASSWORD="example"
MONGO_DATABASE="aggregator"
MONGO_HOSTNAME="172.0.0.58" 
MONGO_PORT=27017


# EMS TLS Configuration (Optional)
# Set to 'true' to enable TLS/HTTPS connections to EMS devices by default
EMS_USE_TLS=true

# Client Certificate for Mutual TLS Authentication (Optional)
# Path to client certificate file (PEM format)
EMS_CERT_FILE=/usr/src/app/certs/client.crt

# Client Private Key for Mutual TLS Authentication (Optional)  
# Path to client private key file (PEM format)
EMS_KEY_FILE=/usr/src/app/certs/client.key

# CA Certificate for Server Verification (Optional)
# Path to Certificate Authority file to verify EMS server certificates
EMS_CA_FILE=/usr/src/app/certs/ca.crt

# SSL Certificate Verification (Optional)
# Set to 'false' to disable SSL certificate verification (NOT recommended for production)
EMS_VERIFY_SSL=true