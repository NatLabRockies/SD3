  {dbc8894d-2c54-454f-80b5-c5663272d2e5}, !- Handle
  total_loads_program calling manager,    !- Name
  EndOfZoneTimestepAfterZoneReporting,    !- EnergyPlus Model Calling Point
  {873d7bbc-f670-498f-b9ac-b890228732f9}; !- Program Name 1

