OS:SpaceInfiltration:DesignFlowRate,
  {115cc3dc-cba1-4261-8925-b69d5f5146fc}, !- Handle
  infil|crawlspace - vented 1,            !- Name
  {54a60949-9d80-4871-8daf-8ff7abc99f42}, !- Space or SpaceType Name
