OS:EnergyManagementSystem:Program,
  {b43aa341-2820-4592-8a27-f22700b2b2c0}, !- Handle
  unmet_hours_program,                    !- Name
  Set htg_unmet_hours = 0,                !- Program Line 1
  Set clg_unmet_hours = 0,                !- Program Line 2
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 3
  If zone_htg_unmet_s > htg_unmet_hours,  !- Program Line 4
  Set htg_unmet_hours = zone_htg_unmet_s, !- Program Line 5
  EndIf,                                  !- Program Line 6
  EndIf,                                  !- Program Line 7
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 8
  If zone_clg_unmet_s > clg_unmet_hours,  !- Program Line 9
  Set clg_unmet_hours = zone_clg_unmet_s, !- Program Line 10
  EndIf,                                  !- Program Line 11
  EndIf;                                  !- Program Line 12

OS:AdditionalProperties,
  {7f6b2ad2-5b37-4702-b03a-ca17b7d06d7f}, !- Handle
  {b43aa341-2820-4592-8a27-f22700b2b2c0}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  unmet hours program;                    !- Feature Value 1

