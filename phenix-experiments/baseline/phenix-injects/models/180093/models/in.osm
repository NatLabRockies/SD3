  {e8260110-8a9e-4f76-8b44-d6884950adab}, !- Handle
  {74833421-0aab-4b13-864b-78011988dd21}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  unmet hours program;                    !- Feature Value 1

