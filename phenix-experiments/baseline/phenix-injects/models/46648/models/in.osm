OS:EnergyManagementSystem:Program,
  {272e46ec-28f1-4f6e-b47a-be3b939d9493}, !- Handle
  unmet_hours_program,                    !- Name
  Set htg_unmet_hours = 0,                !- Program Line 1
  Set clg_unmet_hours = 0,                !- Program Line 2
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 3
  If zone_htg_unmet_s > htg_unmet_hours,  !- Program Line 4
  Set htg_unmet_hours = zone_htg_unmet_s, !- Program Line 5
  EndIf,                                  !- Program Line 6
  EndIf,                                  !- Program Line 7
  If ((DayOfYear >= 1) && (DayOfYear <= 365)), !- Program Line 8
  If zone_clg_unmet_s > clg_unmet_hours,  !- Program Line 9
  Set clg_unmet_hours = zone_clg_unmet_s, !- Program Line 10
  EndIf,                                  !- Program Line 11
  EndIf;                                  !- Program Line 12

OS:AdditionalProperties,
  {723a91a3-00b4-4867-9bf3-2761a88120d5}, !- Handle
  {272e46ec-28f1-4f6e-b47a-be3b939d9493}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  unmet hours program;                    !- Feature Value 1

OS:EnergyManagementSystem:ProgramCallingManager,
  {9135f2a9-62cf-492f-b291-da7b3ef15fba}, !- Handle
  unmet_hours_program calling manager,    !- Name
  EndOfZoneTimestepBeforeZoneReporting,   !- EnergyPlus Model Calling Point
  {272e46ec-28f1-4f6e-b47a-be3b939d9493}; !- Program Name 1

OS:EnergyManagementSystem:Sensor,
  {2824a27e-58bb-450e-8780-aba2364fa017}, !- Handle
  htg_load_cond,                          !- Name
  ,                                       !- Output Variable or Output Meter Index Key Name
  Heating:EnergyTransfer:Zone:CONDITIONED SPACE; !- Output Variable or Output Meter Name

OS:EnergyManagementSystem:Sensor,
  {e08fa70f-ddbc-472c-b87f-3dbbb87d7328}, !- Handle
  clg_load_cond,                          !- Name
  ,                                       !- Output Variable or Output Meter Index Key Name
  Cooling:EnergyTransfer:Zone:CONDITIONED SPACE; !- Output Variable or Output Meter Name

OS:EnergyManagementSystem:Program,
  {beba25e4-667b-40fb-ad40-b61b8ca6e666}, !- Handle
  total_loads_program,                    !- Name
  Set loads_htg_tot = 0,                  !- Program Line 1
  Set loads_clg_tot = 0,                  !- Program Line 2
  If htg_load_cond > 0,                   !- Program Line 3
  Set loads_htg_tot = loads_htg_tot + (htg_load_cond - clg_load_cond) * 1.0, !- Program Line 4
  EndIf,                                  !- Program Line 5
  If clg_load_cond > 0,                   !- Program Line 6
  Set loads_clg_tot = loads_clg_tot + (clg_load_cond - htg_load_cond) * 1.0, !- Program Line 7
  EndIf;                                  !- Program Line 8

OS:AdditionalProperties,
  {c5bdcb0b-d44c-4d95-ad1c-6fe9b79782a5}, !- Handle
  {beba25e4-667b-40fb-ad40-b61b8ca6e666}, !- Object Name
  ObjectType,                             !- Feature Name 1
  String,                                 !- Feature Data Type 1
  total loads program;                    !- Feature Value 1

OS:EnergyManagementSystem:ProgramCallingManager,
  {244f3c70-d53d-4e12-b8cd-2a7e1b65692b}, !- Handle
  total_loads_program calling manager,    !- Name
  EndOfZoneTimestepAfterZoneReporting,    !- EnergyPlus Model Calling Point
  {beba25e4-667b-40fb-ad40-b61b8ca6e666}; !- Program Name 1

