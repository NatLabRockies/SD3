OS:EnergyManagementSystem:Program,
  {368a7c36-aa48-4b8b-989f-88ae56eb256c}, !- Handle
  boiler_hydronic_pump_power_program,     !- Name
  Set heating_plr = boiler_plr_s,         !- Program Line 1
  Set pump_total_eff = boiler_hydronic_pump_rated_mfr / 1000 * 20000.0 / 210.576923076923, !- Program Line 2
  Set pump_vfr = boiler_hydronic_pump_mfr_s / 1000, !- Program Line 3
  If pump_vfr > 0,                        !- Program Line 4
  Set boiler_hydronic_pump_pressure_rise_act = 210.57692307692307 * heating_plr * pump_total_eff / pump_vfr, !- Program Line 5
  Else,                                   !- Program Line 6
  Set boiler_hydronic_pump_pressure_rise_act = 0, !- Program Line 7
  EndIf;                                  !- Program Line 8

