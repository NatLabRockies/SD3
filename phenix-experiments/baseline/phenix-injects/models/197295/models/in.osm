OS:EnergyManagementSystem:Program,
  {1fc240e6-561d-475e-97e4-332cd5834a38}, !- Handle
  natural_vent_program,                   !- Name
  Set Tin = tin_s,                        !- Program Line 1
  Set Tout = tout_s,                      !- Program Line 2
  Set Wout = out_wt_s,                    !- Program Line 3
  Set Pbar = out_pb_s,                    !- Program Line 4
  Set Phiout = (@RhFnTdbWPb Tout Wout Pbar), !- Program Line 5
  Set MaxHR = 0.0115,                     !- Program Line 6
  Set MaxRH = 0.7,                        !- Program Line 7
  Set Tnvsp = (htg_sp_s + clg_sp_s) / 2,  !- Program Line 8
  Set NVavail = natural_vent_s,           !- Program Line 9
  Set ClgSsnAvail = cool_season,          !- Program Line 10
  Set natural_vent_flow_act = 0,          !- Program Line 11
  Set whole_house_fan_flow_act = 0,       !- Program Line 12
  Set whole_house_fan_act = 0,            !- Program Line 13
  If ((Wout < MaxHR) && (Phiout < MaxRH) && (Tin > Tout) && (Tin > Tnvsp) && (ClgSsnAvail > 0)), !- Program Line 14
  Set WHF_Flow = 0,                       !- Program Line 15
  Set Adj = (Tin-Tnvsp)/(Tin-Tout),       !- Program Line 16
  Set Adj = (@Min Adj 1),                 !- Program Line 17
  Set Adj = (@Max Adj 0),                 !- Program Line 18
  If (WHF_Flow > 0),                      !- Program Line 19
  Set whole_house_fan_flow_act = WHF_Flow*Adj, !- Program Line 20
  Set WHF_W = 0,                          !- Program Line 21
  Set whole_house_fan_act = WHF_W*Adj,    !- Program Line 22
  ElseIf (NVavail > 0),                   !- Program Line 23
  Set NVArea = 6169.728047616001,         !- Program Line 24
  Set Cs = 8.968567957270247e-05,         !- Program Line 25
  Set Cw = 6.158219665777789e-05,         !- Program Line 26
  Set Tdiff = Tin-Tout,                   !- Program Line 27
  Set dT = (@Abs Tdiff),                  !- Program Line 28
  Set Vwind = site_vw_s,                  !- Program Line 29
  Set SGNV = NVArea*Adj*((((Cs*dT)+(Cw*(Vwind^2)))^0.5)/1000), !- Program Line 30
  Set MaxNV = 2.1369780228096005,         !- Program Line 31
  Set natural_vent_flow_act = (@Min SGNV MaxNV), !- Program Line 32
  EndIf,                                  !- Program Line 33
  EndIf;                                  !- Program Line 34

