OS:EnergyManagementSystem:Program,
  {b4e529f4-a21c-45bf-b770-f57d54ed9894}, !- Handle
  unit_heater_supply_fan_disaggregate_program, !- Name
  Set unit_heater_supply_fan_primary_htg = 0, !- Program Line 1
  If unit_heater_htg_coil_s > 0,          !- Program Line 2
