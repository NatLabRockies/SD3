OS:EnergyManagementSystem:Subroutine,
  {64d2b035-5847-4b7f-9eee-9ab314bcd103}, !- Handle
  central_ac_airloop_0_duct_subroutine,   !- Name
  Set AH_MFR = central_ac_airloop_AH_MFR / 1, !- Program Line 1
  If AH_MFR>0,                            !- Program Line 2
  Set AH_Tout = central_ac_airloop_AH_Tout, !- Program Line 3
  Set AH_Wout = central_ac_airloop_AH_Wout, !- Program Line 4
  Set RA_T = central_ac_airloop_RA_T,     !- Program Line 5
  Set RA_W = central_ac_airloop_Ra_W,     !- Program Line 6
  Set Fan_RTF = central_ac_airloop_Fan_RTF, !- Program Line 7
  Set DZ_T = central_ac_airloop_0_DZ_T,   !- Program Line 8
  Set DZ_W = central_ac_airloop_0_DZ_W,   !- Program Line 9
  Set AH_VFR = central_ac_airloop_AH_VFR / 1, !- Program Line 10
  Set h_SA = (@HFnTdbW AH_Tout AH_Wout),  !- Program Line 11
  Set h_RA = (@HFnTdbW RA_T RA_W),        !- Program Line 12
  Set h_fg = (@HfgAirFnWTdb AH_Wout AH_Tout), !- Program Line 13
  Set h_DZ = (@HFnTdbW DZ_T DZ_W),        !- Program Line 14
  Set air_cp = 1006.0,                    !- Program Line 15
  Set f_sup = 0.19999999999999998,        !- Program Line 16
  Set f_ret = 0.1,                        !- Program Line 17
  Set sup_lk_mfr = f_sup * AH_MFR,        !- Program Line 18
  Set ret_lk_mfr = f_ret * AH_MFR,        !- Program Line 19
  Set SupTotLkToCond = sup_lk_mfr*(h_RA - h_SA), !- Program Line 20
  Set SupLatLkToCond = sup_lk_mfr*h_fg*(RA_W-AH_Wout), !- Program Line 21
  Set SupSensLkToCond = SupTotLkToCond-SupLatLkToCond, !- Program Line 22
  Set supply_ua = 38.941,                 !- Program Line 23
  Set eTm = 0-((Fan_RTF/(AH_MFR*air_cp))*supply_ua), !- Program Line 24
  Set t_sup = DZ_T+((AH_Tout-DZ_T)*(@Exp eTm)), !- Program Line 25
  Set SupCondToCond = AH_MFR*air_cp*(t_sup-AH_Tout), !- Program Line 26
  Set SupCondToDZ = 0-SupCondToCond,      !- Program Line 27
  Set return_ua = 6.664,                  !- Program Line 28
  Set eTm = 0-((Fan_RTF/(AH_MFR*air_cp))*return_ua), !- Program Line 29
  Set t_ret = DZ_T+((RA_T-DZ_T)*(@Exp eTm)), !- Program Line 30
  Set RetCondToRP = AH_MFR*air_cp*(t_ret-RA_T), !- Program Line 31
  Set RetCondToDZ = 0-RetCondToRP,        !- Program Line 32
  Set RetLatLkToRP = 0,                   !- Program Line 33
  Set RetSensLkToRP = ret_lk_mfr*air_cp*(DZ_T-RA_T), !- Program Line 34
  Set SupTotLkToDZ = sup_lk_mfr*(h_SA-h_DZ), !- Program Line 35
  Set SupLatLkToDZ = sup_lk_mfr*h_fg*(AH_Wout-DZ_W), !- Program Line 36
  Set SupSensLkToDZ = SupTotLkToDZ-SupLatLkToDZ, !- Program Line 37
  Set f_imbalance = f_sup-f_ret,          !- Program Line 38
  Set oa_vfr = 1.0 * f_imbalance * AH_VFR, !- Program Line 39
  Set sup_lk_vfr = f_sup * AH_VFR,        !- Program Line 40
  Set ret_lk_vfr = f_ret * AH_VFR,        !- Program Line 41
  If f_sup > f_ret,                       !- Program Line 42
  Set ZoneMixCondToDZ = 0,                !- Program Line 43
  Set ZoneMixDZToCond = (sup_lk_vfr-ret_lk_vfr)-oa_vfr, !- Program Line 44
  Else,                                   !- Program Line 45
  Set ZoneMixCondToDZ = (ret_lk_vfr-sup_lk_vfr)+oa_vfr, !- Program Line 46
  Set ZoneMixDZToCond = 0,                !- Program Line 47
  EndIf,                                  !- Program Line 48
  Else,                                   !- Program Line 49
  Set SupLatLkToCond = 0,                 !- Program Line 50
  Set SupSensLkToCond = 0,                !- Program Line 51
  Set SupCondToCond = 0,                  !- Program Line 52
  Set RetCondToRP = 0,                    !- Program Line 53
  Set RetLatLkToRP = 0,                   !- Program Line 54
  Set RetSensLkToRP = 0,                  !- Program Line 55
  Set RetCondToDZ = 0,                    !- Program Line 56
  Set SupCondToDZ = 0,                    !- Program Line 57
  Set SupLatLkToDZ = 0,                   !- Program Line 58
  Set SupSensLkToDZ = 0,                  !- Program Line 59
  Set ZoneMixCondToDZ = 0,                !- Program Line 60
  Set ZoneMixDZToCond = 0,                !- Program Line 61
  EndIf,                                  !- Program Line 62
  Set central_ac_airloop_0_SupLatLkToCond = SupLatLkToCond, !- Program Line 63
  Set central_ac_airloop_0_SupSensLkToCond = SupSensLkToCond, !- Program Line 64
  Set central_ac_airloop_0_SupCondToLv = SupCondToCond, !- Program Line 65
  Set central_ac_airloop_0_RetCondToRP = RetCondToRP, !- Program Line 66
  Set central_ac_airloop_0_RetLatLkToRP = RetLatLkToRP, !- Program Line 67
  Set central_ac_airloop_0_RetSensLkToRP = RetSensLkToRP, !- Program Line 68
  Set central_ac_airloop_0_RetCondToDZ = RetCondToDZ, !- Program Line 69
  Set central_ac_airloop_0_SupCondToDZ = SupCondToDZ, !- Program Line 70
  Set central_ac_airloop_0_SupLatLkToDZ = SupLatLkToDZ, !- Program Line 71
  Set central_ac_airloop_0_SupSensLkToDZ = SupSensLkToDZ, !- Program Line 72
  Set central_ac_airloop_0_ZoneMixCondToDZ = ZoneMixCondToDZ, !- Program Line 73
  Set central_ac_airloop_0_ZoneMixDZToCond = ZoneMixDZToCond; !- Program Line 74

OS:EnergyManagementSystem:Program,
  {26b7b91e-040f-4b9d-91d3-6483f96f0445}, !- Handle
  central_ac_airloop_0_duct_program,      !- Name
  Set central_ac_airloop_AH_MFR = central_ac_airloop_AH_MFR_s, !- Program Line 1
  Set central_ac_airloop_Fan_RTF = 0,     !- Program Line 2
  Set central_ac_airloop_Fan_RTF = central_ac_airloop_Fan_RTF + central_ac_airloop_Fan_RTF_s, !- Program Line 3
  Set central_ac_airloop_AH_VFR = central_ac_airloop_AH_VFR_s, !- Program Line 4
  Set central_ac_airloop_AH_Tout = central_ac_airloop_AH_Tout_s, !- Program Line 5
  Set central_ac_airloop_AH_Wout = central_ac_airloop_AH_Wout_s, !- Program Line 6
  Set central_ac_airloop_RA_T = central_ac_airloop_RA_T_s, !- Program Line 7
  Set central_ac_airloop_Ra_W = central_ac_airloop_Ra_W_s, !- Program Line 8
  Set central_ac_airloop_0_DZ_T = central_ac_airloop_0_DZ_T_s, !- Program Line 9
  Set central_ac_airloop_0_DZ_W = central_ac_airloop_0_DZ_W_s, !- Program Line 10
  Run central_ac_airloop_0_duct_subroutine, !- Program Line 11
  Set central_ac_airloop_0_SupSensLkToCond_equip_act = central_ac_airloop_0_SupSensLkToCond, !- Program Line 12
  Set central_ac_airloop_0_SupLatLkToCond_equip_act = central_ac_airloop_0_SupLatLkToCond, !- Program Line 13
  Set central_ac_airloop_0_SupCondToLv_equip_act = central_ac_airloop_0_SupCondToLv, !- Program Line 14
  Set central_ac_airloop_0_RetSensLkToRP_equip_act = central_ac_airloop_0_RetSensLkToRP, !- Program Line 15
  Set central_ac_airloop_0_RetLatLkToRP_equip_act = central_ac_airloop_0_RetLatLkToRP, !- Program Line 16
  Set central_ac_airloop_0_RetCondToRP_equip_act = central_ac_airloop_0_RetCondToRP, !- Program Line 17
  Set central_ac_airloop_0_RetCondToDZ_equip_act = central_ac_airloop_0_RetCondToDZ, !- Program Line 18
  Set central_ac_airloop_0_SupCondToDZ_equip_act = central_ac_airloop_0_SupCondToDZ, !- Program Line 19
  Set central_ac_airloop_0_SupSensLkToDZ_equip_act = central_ac_airloop_0_SupSensLkToDZ, !- Program Line 20
  Set central_ac_airloop_0_SupLatLkToDZ_equip_act = central_ac_airloop_0_SupLatLkToDZ, !- Program Line 21
  Set central_ac_airloop_0_ZoneMixDZToCond_mix_act = central_ac_airloop_0_ZoneMixDZToCond, !- Program Line 22
  Set central_ac_airloop_0_ZoneMixCondToDZ_mix_act = central_ac_airloop_0_ZoneMixCondToDZ; !- Program Line 23

