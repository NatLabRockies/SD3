OS:EnergyManagementSystem:Program,
  {fb3ca14c-0b42-4a74-a407-d522455e3edb}, !- Handle
  air_source_heat_pump_supply_fan_disaggregate_program, !- Name
  Set air_source_heat_pump_supply_fan_clg = 0, !- Program Line 1
  Set air_source_heat_pump_supply_fan_primary_htg = 0, !- Program Line 2
  Set air_source_heat_pump_supply_fan_backup_htg = 0, !- Program Line 3
  If air_source_heat_pump_clg_coil_s > 0, !- Program Line 4
  Set air_source_heat_pump_supply_fan_clg = air_source_heat_pump_supply_fan_s, !- Program Line 5
  ElseIf air_source_heat_pump_htg_coil_s > 0 && (air_source_heat_pump_backup_htg_coil_s > 0), !- Program Line 6
  Set air_source_heat_pump_supply_fan_primary_htg = air_source_heat_pump_supply_fan_s * air_source_heat_pump_htg_coil_s / (air_source_heat_pump_htg_coil_s + air_source_heat_pump_backup_htg_coil_s), !- Program Line 7
