  Heating:EnergyTransfer:Zone:AIR SOURCE HEAT PUMP AIRLOOP RET AIR ZONE; !- Output Variable or Output Meter Name

OS:EnergyManagementSystem:Sensor,
  {5b4caded-c79f-4483-9928-f147605dfd8a}, !- Handle
