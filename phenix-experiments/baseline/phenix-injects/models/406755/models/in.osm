  Set air_source_heat_pump_airloop_Ra_W = air_source_heat_pump_airloop_Ra_W_s, !- Program Line 9
  Set air_source_heat_pump_airloop_0_DZ_T = air_source_heat_pump_airloop_0_DZ_T_s, !- Program Line 10
  Set air_source_heat_pump_airloop_0_DZ_W = air_source_heat_pump_airloop_0_DZ_W_s, !- Program Line 11
  Run air_source_heat_pump_airloop_0_duct_subroutine, !- Program Line 12
  Set air_source_heat_pump_airloop_0_SupSensLkToCond_equip_act = air_source_heat_pump_airloop_0_SupSensLkToCond, !- Program Line 13
  Set air_source_heat_pump_airloop_0_SupLatLkToCond_equip_act = air_source_heat_pump_airloop_0_SupLatLkToCond, !- Program Line 14
  Set air_source_heat_pump_airloop_0_SupCondToLv_equip_act = air_source_heat_pump_airloop_0_SupCondToLv, !- Program Line 15
  Set air_source_heat_pump_airloop_0_RetSensLkToRP_equip_act = air_source_heat_pump_airloop_0_RetSensLkToRP, !- Program Line 16
  Set air_source_heat_pump_airloop_0_RetLatLkToRP_equip_act = air_source_heat_pump_airloop_0_RetLatLkToRP, !- Program Line 17
  Set air_source_heat_pump_airloop_0_RetCondToRP_equip_act = air_source_heat_pump_airloop_0_RetCondToRP, !- Program Line 18
  Set air_source_heat_pump_airloop_0_RetCondToDZ_equip_act = air_source_heat_pump_airloop_0_RetCondToDZ, !- Program Line 19
  Set air_source_heat_pump_airloop_0_SupCondToDZ_equip_act = air_source_heat_pump_airloop_0_SupCondToDZ, !- Program Line 20
  Set air_source_heat_pump_airloop_0_SupSensLkToDZ_equip_act = air_source_heat_pump_airloop_0_SupSensLkToDZ, !- Program Line 21
  Set air_source_heat_pump_airloop_0_SupLatLkToDZ_equip_act = air_source_heat_pump_airloop_0_SupLatLkToDZ, !- Program Line 22
  Set air_source_heat_pump_airloop_0_ZoneMixDZToCond_mix_act = air_source_heat_pump_airloop_0_ZoneMixDZToCond, !- Program Line 23
  Set air_source_heat_pump_airloop_0_ZoneMixCondToDZ_mix_act = air_source_heat_pump_airloop_0_ZoneMixCondToDZ; !- Program Line 24

